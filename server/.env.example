# SaleScope POS Environment Configurations

# Express Server Port
PORT=3000

# ── Hybrid Licensing Configurations ─────────────────────────────────

# URL of the dedicated licensing server (lic-server)
LIC_SERVER_URL="http://localhost:5000"

# RS256 Public Key generated by the licensing server (from npm run keygen).
# Copy the exact contents of the server's .keys/public.pem here.
# Note: For multi-line values in .env, you can use double quotes and escape newlines with \n.
LIC_SERVER_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n-----END PUBLIC KEY-----"

# How often SaleScope should ping the server to validate/refresh status (in days).
# Default: 3 days.
LIC_VALIDATION_INTERVAL_DAYS=3

# The maximum offline grace period allowed if the licensing server is down or internet is offline (in days).
# After this period, SaleScope will lock downPOS billing features until an online check succeeds.
# Default: 7 days.
LIC_OFFLINE_GRACE_DAYS=7
